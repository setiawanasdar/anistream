# Server
PORT=3001
NODE_ENV=development

# Source base URLs (override if domains change)
OTAKUDESU_URL=https://otakudesu.cloud
SAMEHADAKU_URL=https://samehadaku.email
NEONIME_URL=https://neonime.fun

# Toggle individual sources (true/false)
OTAKUDESU_ENABLED=true
SAMEHADAKU_ENABLED=true
NEONIME_ENABLED=true

# Cache TTLs in seconds
CACHE_TTL_ONGOING=300
CACHE_TTL_DETAIL=1800
CACHE_TTL_EPISODE=600
CACHE_TTL_SCHEDULE=3600
CACHE_TTL_GENRES=86400

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
